{
	"name": "fusion-svelte-vite-starter",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev --port=4200",
		"ingest": "node scripts/ingest-all-content.js",
		"ingest:documents": "node scripts/ingest-local-documents.mjs",
		"ingest:builder": "node scripts/ingest-builder-content.mjs",
		"prepare:rag": "node scripts/ingest-local-documents.mjs",
		"prepare:rag:all": "node scripts/ingest-all-content.js",
		"prepare:embeddings": "node scripts/precompute-embeddings.mjs",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"generate:genealogy-tree": "node scripts/generate-genealogy-tree.mjs",
		"parse:mermaid-graph": "node scripts/parse-mermaid-graph.mjs",
		"generate:graphs": "npm run generate:genealogy-tree && npm run parse:mermaid-graph",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --fail-on-warnings false",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run",
		"storybook": "storybook dev -p 6006",
		"build-storybook": "storybook build"
	},
	"devDependencies": {
		"@builder.io/sdk-svelte": "^5.1.0",
		"@builder.io/storybook": "^0.0.3",
		"@chromatic-com/storybook": "^5.0.0",
		"@emailjs/browser": "^4.4.1",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@storybook/addon-a11y": "^10.2.7",
		"@storybook/addon-docs": "^10.2.7",
		"@storybook/addon-svelte-csf": "^5.0.10",
		"@storybook/addon-vitest": "^10.2.7",
		"@storybook/sveltekit": "^10.2.7",
		"@sveltejs/adapter-vercel": "^6.3.4",
		"@sveltejs/kit": "2.47.2",
		"@sveltejs/vite-plugin-svelte": "^6.0.0",
		"@vitest/browser": "^3.2.3",
		"@vitest/browser-playwright": "4.0.17",
		"@vitest/coverage-v8": "4.0.17",
		"autoprefixer": "^10.4.16",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-storybook": "^10.2.7",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"pdf-parse": "^2.4.5",
		"playwright": "^1.53.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"storybook": "^10.2.7",
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"tailwindcss": "^3.4.11",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "npm:rolldown-vite@latest",
		"vitest": "^4.0.0",
		"vitest-browser-svelte": "^0.1.0"
	},
	"overrides": {
		"svelte": "^5.43.8",
		"svelte-check": "^4.3.4",
		"svelte-preprocess": "^6.0.0"
	},
	"dependencies": {
		"@ai-sdk/anthropic": "^3.0.38",
		"@ai-sdk/openai": "^3.0.0",
		"@anthropic-ai/sdk": "^0.73.0",
		"@builder.io/sdk": "^6.1.3",
		"@huggingface/transformers": "^3.8.1",
		"@xenova/transformers": "2.17.2",
		"ai": "^6.0.77",
		"cytoscape": "^3.33.1",
		"cytoscape-dagre": "^2.5.0",
		"dotenv": "^17.2.3",
		"js-yaml": "^4.1.1",
		"mammoth": "^1.11.0",
		"valibot": "^1.2.0"
	}
}
