# Builder public content
PUBLIC_BUILDER_API_KEY=your-builder-api-key

# Answer model provider (server-only)
AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=your-anthropic-key
ANTHROPIC_MODEL=claude-3-5-haiku-20241022
# Or use an OpenAI-compatible provider:
# AI_PROVIDER=openai
# OPENAI_API_KEY=your-openai-key
# OPENAI_MODEL=gpt-4o-mini
# OPENAI_API_BASE=https://api.openai.com/v1

# Existing Supabase project (server-only; never use PUBLIC_ or VITE_ prefixes)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_VECTOR_SEARCH_FUNCTION=match_documents
SUPABASE_VECTOR_QUERY_PARAMETER=query_embedding
SUPABASE_VECTOR_MATCH_COUNT=6
SUPABASE_VECTOR_MATCH_THRESHOLD=0.7

# Must match the embedding model used to create the existing vector corpus
EMBEDDING_API_KEY=your-embedding-provider-key
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_API_BASE=https://api.openai.com/v1

# Anonymous usage protection and budget defaults
AI_VISITOR_SECRET=replace-with-a-long-random-secret
AI_MONTHLY_BUDGET_USD=20
AI_DAILY_VISITOR_BUDGET_USD=0.25
AI_DAILY_VISITOR_TOKEN_LIMIT=5000
AI_BURST_LIMIT=8
AI_BURST_WINDOW_SECONDS=60
AI_MAX_MESSAGE_LENGTH=2000
AI_MAX_HISTORY_MESSAGES=6
AI_MAX_OUTPUT_TOKENS=320
AI_RESERVE_COST_USD=0.01
# Set these to the selected provider's current per-million-token rates.
AI_INPUT_COST_PER_MILLION=0.8
AI_OUTPUT_COST_PER_MILLION=4
EMBEDDING_INPUT_COST_PER_MILLION=0.02

# Contact form (if enabled)
VITE_EMAILJS_SERVICE_ID=your-service-id
VITE_EMAILJS_TEMPLATE_ID=your-template-id
VITE_EMAILJS_PUBLIC_KEY=your-public-key
