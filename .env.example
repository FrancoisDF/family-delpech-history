# AI Provider Configuration
# This project supports both Anthropic and OpenAI-compatible AI providers
# Choose your provider via the AI_PROVIDER environment variable

# ============================================================================
# PROVIDER SELECTION (required)
# ============================================================================
# Options: 'anthropic' or 'openai' (defaults to 'anthropic' if not set)
AI_PROVIDER=anthropic

# ============================================================================
# ANTHROPIC CONFIGURATION (required if AI_PROVIDER=anthropic)
# ============================================================================
# Get your API key from: https://console.anthropic.com/
# After obtaining your key, set it below
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Optional: Override the default model (defaults to claude-3-5-sonnet-20241022)
# Available models: claude-3-5-sonnet-20241022, claude-3-5-haiku-20241022, etc.
ANTHROPIC_MODEL=claude-3-5-sonnet-20241022

# ============================================================================
# OPENAI-COMPATIBLE PROVIDER CONFIGURATION (required if AI_PROVIDER=openai)
# ============================================================================

# API Key for OpenAI or your private OpenAI-compatible server
# For OpenAI: Get from https://platform.openai.com/api-keys/
# For private servers: Use your provider's API key format
OPENAI_API_KEY=sk-your-key-here

# Model name to use
# For OpenAI: gpt-4, gpt-3.5-turbo, etc.
# For private servers: Depends on what models your server supports
OPENAI_MODEL=gpt-3.5-turbo

# Optional: Base URL for OpenAI-compatible server (defaults to https://api.openai.com/v1)
# Example for local server: http://localhost:8000/v1
# Example for Azure: https://your-resource.openai.azure.com/v1
OPENAI_API_BASE=https://api.openai.com/v1

# ============================================================================
# NOTES
# ============================================================================
# 1. Backwards Compatibility:
#    - If no AI_PROVIDER is set, the system defaults to Anthropic
#    - If ANTHROPIC_API_KEY exists but no provider is specified, it uses Anthropic
#    
# 2. Provider-Specific Variables:
#    - Only set the variables for the provider you're using
#    - Extra variables won't cause errors, but are unnecessary
#    
# 3. Usage Examples:
#    
#    a) Using Anthropic (default):
#       AI_PROVIDER=anthropic
#       ANTHROPIC_API_KEY=sk-ant-xxx
#    
#    b) Using OpenAI:
#       AI_PROVIDER=openai
#       OPENAI_API_KEY=sk-xxx
#       OPENAI_MODEL=gpt-3.5-turbo
#    
#    c) Using a private OpenAI-compatible server:
#       AI_PROVIDER=openai
#       OPENAI_API_KEY=your-server-key
#       OPENAI_MODEL=your-model-name
#       OPENAI_API_BASE=http://localhost:8000/v1
#
# 4. Error Handling:
#    - If required variables are missing, the system will throw a clear error
#    - Check the error message to see which variables need to be set
#
# 5. For Summarization Scripts:
#    - scripts/generate-summaries-generic.mjs uses the same environment variables
#    - Run with: AI_PROVIDER=anthropic ANTHROPIC_API_KEY=xxx node scripts/generate-summaries-generic.mjs
#    - Or: AI_PROVIDER=openai OPENAI_API_KEY=xxx OPENAI_MODEL=xxx node scripts/generate-summaries-generic.mjs
